{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LimitLens",
  "version": "0.1.0",
  "identifier": "com.limitlens.widget",
  "build": {
    "beforeDevCommand": "npm.cmd run dev:frontend",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LimitLens",
        "width": 425,
        "height": 156,
        "minWidth": 350,
        "minHeight": 128,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A lightweight AI coding-service usage widget",
    "longDescription": "LimitLens is a local-first desktop widget for viewing supported AI coding-service usage limits.",
    "createUpdaterArtifacts": false
  }
}
